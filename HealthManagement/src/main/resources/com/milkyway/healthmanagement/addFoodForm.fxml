<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.milkyway.healthmanagement.AddFoodFormController" 
          prefHeight="680.0" prefWidth="420.0" styleClass="anchor-pane" stylesheets="@style/addFood.css">
    <children>
        <VBox spacing="15" layoutX="30.0" layoutY="30.0" prefWidth="360.0" styleClass="form-container">
            <Label text="THÊM THỰC PHẨM MỚI" styleClass="title-label" />
            
            <HBox styleClass="form-row">
                <Label text="Tên thực phẩm:" prefWidth="120.0" styleClass="form-label" />
                <TextField fx:id="nameField" prefWidth="240.0" promptText="Nhập tên thực phẩm" />
            </HBox>
            
            <HBox styleClass="form-row">
                <Label text="Số lượng:" prefWidth="120.0" styleClass="form-label" />
                <TextField fx:id="quantityField" prefWidth="240.0" promptText="Nhập số lượng" />
            </HBox>
            
            <HBox styleClass="form-row">
                <Label text="Đơn vị:" prefWidth="120.0" styleClass="form-label" />
                <ComboBox fx:id="unitComboBox" prefWidth="240.0" promptText="Chọn đơn vị" />
            </HBox>
            
            <HBox styleClass="form-row">
                <Label text="Calo (cal):" prefWidth="120.0" styleClass="form-label" />
                <TextField fx:id="caloField" prefWidth="240.0" promptText="Nhập lượng calo" />
            </HBox>
            
            <HBox styleClass="form-row">
                <Label text="Carb (g):" prefWidth="120.0" styleClass="form-label" />
                <TextField fx:id="carbField" prefWidth="240.0" promptText="Nhập lượng carb" />
            </HBox>
            
            <HBox styleClass="form-row">
                <Label text="Lipid (g):" prefWidth="120.0" styleClass="form-label" />
                <TextField fx:id="lipidField" prefWidth="240.0" promptText="Nhập lượng lipid" />
            </HBox>
            
            <HBox styleClass="form-row">
                <Label text="Protein (g):" prefWidth="120.0" styleClass="form-label" />
                <TextField fx:id="proteinField" prefWidth="240.0" promptText="Nhập lượng protein" />
            </HBox>
            
            <HBox styleClass="form-row">
                <Label text="Natri (mg):" prefWidth="120.0" styleClass="form-label" />
                <TextField fx:id="natriField" prefWidth="240.0" promptText="Nhập lượng natri" />
            </HBox>
            
            <HBox styleClass="form-row">
                <Label text="Đường (g):" prefWidth="120.0" styleClass="form-label" />
                <TextField fx:id="sugarField" prefWidth="240.0" promptText="Nhập lượng đường" />
            </HBox>
            
            <HBox spacing="30" alignment="CENTER" styleClass="buttons-container">
                <Button text="Lưu" onAction="#handleSave" prefWidth="100" />
                <Button text="Hủy" onAction="#handleCancel" prefWidth="100" styleClass="cancel-button" />
            </HBox>
        </VBox>
    </children>
</AnchorPane>
