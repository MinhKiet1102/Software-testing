<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.milkyway.healthmanagement.AddMealFoodController">
    <children>
        <VBox spacing="10.0" alignment="TOP_CENTER" AnchorPane.topAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0">
            <Label text="Thêm Món Ăn Mới" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" />
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>
                
                <rowConstraints>
                    <RowConstraints valignment="CENTER"/>
                </rowConstraints>

                <Label text="Tên Thức Ăn:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="foodNameField" promptText="Ví dụ: Chuối" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Lượng Calo (cal):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="caloriesField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Carbohydrate (g):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="carbsField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Lipid (g):" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="fatField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Protein (g):" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="proteinField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <Label text="Natri (mg):" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <TextField fx:id="sodiumField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                <Label text="Đường (g):" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <TextField fx:id="sugarField" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="20" alignment="CENTER">
                <Button text="Lưu" onAction="#handleSave"/>
                <Button text="Hủy" onAction="#handleCancel"/>
            </HBox>
        </VBox>
    </children>
</AnchorPane>
